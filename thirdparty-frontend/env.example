# Example environment variables for thirdparty-frontend
#
# Copy this file to ".env" and adjust the values as needed.
# The Docker dev setup already loads "./thirdparty-frontend/.env"
# into the Angular container via docker-compose.dev.yml.

# Base URL of the UAM backend that this app talks to.
# In local Docker dev, the UAM backend is exposed on port 3001.
NG_APP_UAM_API_BASE_URL=http://localhost:3001


