# UAM Frontend – Environment Example
# Copy this file to `.env` and adjust values for your environment.

# Base URL of the UAM backend API (NestJS service)
API_BASE_URL=http://localhost:3001

# Default tenant ID used when creating users/roles from the UI
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# System admin / service user ID used for invitations, etc.
SYSTEM_ADMIN_USER_ID=00000000-0000-0000-0000-000000000000