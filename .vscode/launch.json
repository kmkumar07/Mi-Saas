{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug SS Backend",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "address": "localhost",
      "localRoot": "${workspaceFolder}/ss-backend",
      "remoteRoot": "/usr/src/app",
      "sourceMaps": true,
      "restart": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Debug UAM Backend",
      "type": "node",
      "request": "attach",
      "port": 9230,
      "address": "localhost",
      "localRoot": "${workspaceFolder}/uam-backend",
      "remoteRoot": "/usr/src/app",
      "sourceMaps": true,
      "restart": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Debug Thirdparty Backend",
      "type": "node",
      "request": "attach",
      "port": 9231,
      "address": "localhost",
      "localRoot": "${workspaceFolder}/thirdparty-backend",
      "remoteRoot": "/usr/src/app",
      "sourceMaps": true,
      "restart": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Debug All Backends",
      "configurations": [
        "Debug SS Backend",
        "Debug UAM Backend",
        "Debug Thirdparty Backend"
      ]
    }
  ]
}